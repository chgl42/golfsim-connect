<!doctype html>
<html><head><meta charset="utf-8"><title>GolfSim Connect – Third-party licenses</title>
<style>body{font:14px/1.5 -apple-system,Helvetica,Arial,sans-serif;max-width:900px;margin:2em auto;padding:0 1em;color:#222}
pre{white-space:pre-wrap;background:#f5f5f5;padding:1em;font-size:12px}h2{margin-top:2em}li{margin:.1em 0}</style></head>
<body>
<h1>Third-party licenses</h1>
<p>GolfSim Connect includes the following open-source components.</p>
<h2>Overview</h2>
<ul>{{#each overview}}<li><a href="#{{id}}">{{name}}</a> ({{count}})</li>{{/each}}</ul>
{{#each licenses}}
<h2 id="{{id}}">{{name}}</h2>
<p>Used by:</p>
<ul>{{#each used_by}}<li><a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a></li>{{/each}}</ul>
<pre>{{text}}</pre>
{{/each}}
</body></html>
